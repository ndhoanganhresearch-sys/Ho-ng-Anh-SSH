# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------------------
# Virtual environments / Môi trường ảo
# ---------------------------------------------------------------------------
.venv/
.venv*/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Editors / IDE
# ---------------------------------------------------------------------------
.idea/
.vscode/
.cursor/
*.swp

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Backups & temporary work / Tệp sao lưu & tạm
# ---------------------------------------------------------------------------
*_backup.py
*.bak
_*.py
_*.txt
~$*.docx
tunnel_project/i18n_missing_scan.txt

# ---------------------------------------------------------------------------
# Build / runtime output / Kết xuất khi chạy
# ---------------------------------------------------------------------------
node_modules/
*.png
ssl_tunnel_view.png
tunnel_project/data/blender_test_suite/benchmark_report.json

# ---------------------------------------------------------------------------
# Large point-cloud data / Dữ liệu point cloud lớn
# ---------------------------------------------------------------------------
*.las
*.laz
*.ply
tunnel_project/data/sample_pcd/*.txt

# ---------------------------------------------------------------------------
# Generated merge artifacts / Tệp gộp sinh ra khi chạy
# ---------------------------------------------------------------------------
_merged.json

# ---------------------------------------------------------------------------
# Logs / Nhật ký sinh khi chạy
# ---------------------------------------------------------------------------
*.log

# ---------------------------------------------------------------------------
# Reference clones (read-only study material, not part of the project)
# ---------------------------------------------------------------------------
_ref_*/

# Keep package markers (the _*.py rule above also matches __init__.py)
!**/__init__.py

# Local Claude/Codex agent state
.claude/

# Local secrets / Obsidian runtime (never commit)
.obsidian-mcp.env
.obsidian/


# Large generated datasets / review binaries (keep local, do not push)
tunnel_project/data/curved_real_scale_railway_tunnel_t0t5/full_interior_dataset/current_visual_samples.json
tunnel_project/data/real_scale_railway_tunnel_t0t5/full_interior_dataset/current_visual_samples.json
tunnel_project/data/blend_files_for_review/
tunnel_project/data/blender_lidar_t0t5_realistic/*.txt
tunnel_project/data/blender_lidar_t0t5_sample_based/*.txt
